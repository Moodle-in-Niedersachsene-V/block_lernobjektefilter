{{!
    @template block_lernobjektefilter/block

    Learning object filter block with category select, activity type chips, keyword chips and search term.
    Every filter carries a help icon (blue question mark) with an explanation.

    Example context (json):
    {
        "blockid": 1,
        "configured": true,
        "categories": [{"value": "", "label": "– All –"}, {"value": "3", "label": "Lernobjekte / Mathematik"}],
        "modtypes": [{"value": "scorm", "label": "SCORM package", "iconurl": "https://example.org/theme/image.php/boost/scorm/1/monologo"}],
        "groups": [{"key": "subject", "label": "Subject", "values": ["Mathematik", "Deutsch"]}]
    }
}}
<div class="lof-block" id="lof-block-{{blockid}}">
  {{^configured}}
  <div class="alert alert-info small mb-0" role="status">
    {{#str}} hint_notconfigured, block_lernobjektefilter {{/str}}
  </div>
  {{/configured}}
  {{#configured}}

  <div class="mb-2">
    <label for="lof-category-{{blockid}}" class="small text-muted fw-semibold text-uppercase mb-1 d-inline-block">
      {{#str}} label_category, block_lernobjektefilter {{/str}}
    </label>
    {{#helpcategory}}{{>core/help_icon}}{{/helpcategory}}
    <select class="form-select form-select-sm" id="lof-category-{{blockid}}" data-filter="category">
      {{#categories}}
      <option value="{{value}}">{{label}}</option>
      {{/categories}}
    </select>
  </div>

  <div class="mb-2" role="group" aria-labelledby="lof-modtype-label-{{blockid}}">
    <div class="mb-1">
      <span id="lof-modtype-label-{{blockid}}" class="small text-muted fw-semibold text-uppercase">
        {{#str}} label_modtype, block_lernobjektefilter {{/str}}
      </span>
      {{#helpmodtype}}{{>core/help_icon}}{{/helpmodtype}}
    </div>
    {{#modtypes}}
    <button type="button" class="badge lof-chip" data-filter="modtype" data-value="{{value}}" aria-pressed="false">
      <img src="{{iconurl}}" class="lof-chip-icon" alt="" aria-hidden="true">{{label}}
    </button>
    {{/modtypes}}
  </div>

  {{#groups}}
  <div class="mb-2" role="group" aria-labelledby="lof-{{key}}-label-{{blockid}}">
    <div class="mb-1">
      <span id="lof-{{key}}-label-{{blockid}}" class="small text-muted fw-semibold text-uppercase">{{label}}</span>
      {{#help}}{{>core/help_icon}}{{/help}}
    </div>
    {{#values}}
    <button type="button" class="badge lof-chip" data-filter="tag" data-group="{{key}}" data-value="{{.}}" aria-pressed="false">{{.}}</button>
    {{/values}}
  </div>
  {{/groups}}

  <div class="mb-3">
    <label for="lof-searchterm-{{blockid}}" class="small text-muted fw-semibold text-uppercase mb-1 d-inline-block">
      {{#str}} label_searchterm, block_lernobjektefilter {{/str}}
    </label>
    {{#helpsearchterm}}{{>core/help_icon}}{{/helpsearchterm}}
    <div class="input-group input-group-sm">
      <span class="input-group-text"><i class="fa fa-search" aria-hidden="true"></i></span>
      <input type="text"
             class="form-control"
             id="lof-searchterm-{{blockid}}"
             data-filter="searchterm"
             maxlength="100"
             placeholder="{{#str}} placeholder_searchterm, block_lernobjektefilter {{/str}}"
             autocomplete="off">
    </div>
  </div>

  <hr class="my-2">

  <div class="d-flex justify-content-between align-items-center mb-1">
    <small class="text-muted" data-region="count" aria-live="polite">–</small>
    <button type="button" class="btn btn-link btn-sm p-0 text-muted small" data-action="reset">
      {{#str}} btn_reset, block_lernobjektefilter {{/str}}
    </button>
  </div>

  <div class="lof-results" data-region="results">
    <div class="text-center text-muted small py-3">
      {{#str}} hint_setfilter, block_lernobjektefilter {{/str}}
    </div>
  </div>

  <div class="lof-spinner text-center py-2 d-none" data-region="spinner">
    <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
  </div>
  {{/configured}}
</div>
