<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/lernobjektefilter/db" VERSION="20261015" COMMENT="XMLDB file for block_lernobjektefilter"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="block_lernobjektefilter_sugg" COMMENT="AI tag suggestion and its outcome (pending, applied, discarded, empty) per learning object">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="cmid"         TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course module ID of the learning object"/>
        <FIELD NAME="tags"         TYPE="text"             NOTNULL="true" SEQUENCE="false" COMMENT="Suggested keywords as JSON list"/>
        <FIELD NAME="status"       TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" DEFAULT="pending"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="cmid"   UNIQUE="true"  FIELDS="cmid"/>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
